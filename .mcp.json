{
  "mcpServers": {
    "hoist-core": {
      "type": "stdio",
      "command": "bash",
      "args": ["mcp/bootstrap.sh"]
    },
    "github": {
      "command": "bash",
      "args": [
        "-c",
        "GITHUB_PERSONAL_ACCESS_TOKEN=\"$(gh auth token)\" exec docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server"
      ]
    },
    "jetbrains": {
      "type": "http",
      "url": "http://127.0.0.1:${JETBRAINS_MCP_PORT:-64342}/stream"
    }
  }
}
